{
  "manifest_version": 3,
  "name": "ChatGPT Status Dot",
  "version": "1.1.0",
  "description": "A small favicon dot while ChatGPT works, and a different color when a response finishes in the background.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://cdn.oaistatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Status Dot",
    "default_popup": "popup.html"
  }
}
